      "label": "TaskFlow initial git and backup audit",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "-d",
        "Ubuntu",
        "--cd",
        "/mnt/g/My Skill Learn Plan/Technology/Cloud & DevOps/DevSecOps/DevOps/Portfolio Project/devops-real-world-project",
        "--",
        "bash",
        "-lc",
        "git status --short --untracked-files=all; echo BRANCH; git branch --show-current; echo HEAD; git rev-parse HEAD; echo CACHED; git diff --cached --stat; echo TRACKED_BACKUPS; git ls-files '*backup*' '.env' 'terraform/*.tfstate' 'terraform/*.tfplan'; echo ALL_BACKUP_NAMES; find . -maxdepth 4 -type f \\( -iname '*backup*' -o -iname '*.bak' -o -iname '*.old' \\) -print"
