.DS_Store

# Local application databases
instance/*.db
instance/*.db-*


# Terraform local configuration and state
terraform/terraform.tfvars
terraform/terraform.tfstate
terraform/terraform.tfstate.*
terraform/.terraform/



# Terraform local configuration, state, plans, and crash logs
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Local Terraform variable files
*.tfvars
*.tfvars.json

# Keep the provider dependency lock file tracked
!terraform/.terraform.lock.hcl

# Node.js dependencies
node_modules/
**/node_modules/

# Terraform local configuration and state under devops
devops/terraform/terraform.tfvars
devops/terraform/terraform.tfstate
devops/terraform/terraform.tfstate.*
devops/terraform/.terraform/

# Keep the devops Terraform provider lock file tracked
!devops/terraform/.terraform.lock.hcl
