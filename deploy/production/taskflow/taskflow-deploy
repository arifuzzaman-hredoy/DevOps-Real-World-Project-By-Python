#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

COMPOSE_FILE="/opt/taskflow/compose.yaml"
SERVICE="api"
CONTAINER="taskflow-api-1"
IMAGE_REPO="ghcr.io/arifuzzaman-hredoy/devops-real-world-project-by-python"
HEALTH_URL="https://taskflow.oxytumzone.com/api/ready"
HEALTH_ATTEMPTS=18
ROLLBACK_ATTEMPTS=12
RETRY_SECONDS=5
TMP_DIR=""

cleanup() {
    local exit_status=$?
    trap - EXIT
    if [[ -n "$TMP_DIR" ]]; then
        rm -rf -- "$TMP_DIR" >/dev/null 2>&1 || true
    fi
    exit "$exit_status"
}
trap cleanup EXIT

if [[ $# -ne 1 ]]; then
    echo "Usage: sudo taskflow-deploy sha-<40-character commit SHA>" >&2
    exit 2
fi

TAG="$1"
if [[ ! "$TAG" =~ ^sha-[0-9a-f]{40}$ ]]; then
    echo "ERROR: Image tag must be sha-<40-character lowercase commit SHA>." >&2
    exit 2
fi

NEW_IMAGE="${IMAGE_REPO}:${TAG}"
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/taskflow-deploy.XXXXXXXX")"
chmod 700 "$TMP_DIR"
PUBLIC_RESPONSE="$TMP_DIR/public-readiness.json"

health_json_is_ready() {
    grep -Eq '"status"[[:space:]]*:[[:space:]]*"ready"' "$1" &&
        grep -Eq '"database"[[:space:]]*:[[:space:]]*"ok"' "$1"
}

container_running() {
    local running
    running="$(sudo docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" ||
        return 1
    [[ "$running" == "true" ]]
}

container_image_matches() {
    local expected_image_id="$1"
    local actual_image_id
    actual_image_id="$(sudo docker inspect --format '{{.Image}}' "$CONTAINER" 2>/dev/null)" ||
        return 1
    [[ "$actual_image_id" == "$expected_image_id" ]]
}

internal_readiness() {
    if sudo docker exec "$CONTAINER" node -e '
fetch("http://127.0.0.1:3000/api/ready", { signal: AbortSignal.timeout(3000) })
  .then(async response => {
    const payload = await response.json();
    if (!response.ok || payload.status !== "ready" || payload.database !== "ok") process.exit(1);
  })
  .catch(() => process.exit(1));
' >/dev/null 2>&1; then
        return 0
    fi

    sudo docker inspect "$CONTAINER" \
        --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
        2>/dev/null | grep -qx healthy
}

public_readiness() {
    local http_status
    http_status="$(
        curl --connect-timeout 5 --max-time 10 --silent --show-error \
            --output "$PUBLIC_RESPONSE" --write-out '%{http_code}' "$HEALTH_URL" \
            2>/dev/null
    )" || return 1
    [[ "$http_status" == "200" ]] && health_json_is_ready "$PUBLIC_RESPONSE"
}

reload_nginx() {
    sudo docker exec taskflow-nginx-1 nginx -t >/dev/null 2>&1 &&
        sudo docker exec taskflow-nginx-1 nginx -s reload >/dev/null 2>&1
}

compose_api_with_image() {
    local image="$1"
    TASKFLOW_API_IMAGE="$image" sudo --preserve-env=TASKFLOW_API_IMAGE \
        docker compose -f "$COMPOSE_FILE" up -d --no-deps "$SERVICE" >/dev/null 2>&1 &&
        reload_nginx
}

verify_deployed_image() {
    local expected_image_id="$1"
    local running=0
    local image_matches=0
    local internal_ready=0
    local public_ready=0

    container_running && running=1
    container_image_matches "$expected_image_id" && image_matches=1
    internal_readiness && internal_ready=1
    public_readiness && public_ready=1

    [[ "$running" -eq 1 && "$image_matches" -eq 1 &&
        "$internal_ready" -eq 1 && "$public_ready" -eq 1 ]]
}

rollback() {
    local rollback_command_succeeded=1
    local rollback_verified=0
    local rollback_config_dir="${TASKFLOW_ROLLBACK_CONFIG_DIR:-}"

    echo "Deployment failed; attempting rollback to the captured previous image."
    if [[ -n "$rollback_config_dir" ]]; then
        if [[ ! -s "$rollback_config_dir/compose.yaml" ||
            ! -s "$rollback_config_dir/nginx.conf" ]]; then
            echo "CRITICAL: Rollback configuration backup is incomplete."
            return 1
        fi
        cp -- "$rollback_config_dir/compose.yaml" "$COMPOSE_FILE"
        cp -- "$rollback_config_dir/nginx.conf" "$APP_DIR/nginx.conf"
        if ! sudo docker compose -f "$COMPOSE_FILE" config --quiet ||
            ! sudo docker exec taskflow-nginx-1 nginx -t >/dev/null 2>&1; then
            echo "CRITICAL: Previous production configuration could not be restored."
            return 1
        fi
    fi

    if ! compose_api_with_image "$OLD_IMAGE_REF"; then
        rollback_command_succeeded=0
    fi

    for ((attempt = 1; attempt <= ROLLBACK_ATTEMPTS; attempt++)); do
        local running=0
        local image_matches=0
        local internal_ready=0
        local public_ready=0

        container_running && running=1
        container_image_matches "$OLD_IMAGE_ID" && image_matches=1
        internal_readiness && internal_ready=1
        public_readiness && public_ready=1

        if [[ "$running" -eq 1 && "$image_matches" -eq 1 &&
            "$internal_ready" -eq 1 && "$public_ready" -eq 1 ]]; then
            rollback_verified=1
            break
        fi
        sleep "$RETRY_SECONDS"
    done

    if [[ "$rollback_command_succeeded" -eq 1 && "$rollback_verified" -eq 1 ]]; then
        echo "Deployment failed; rollback succeeded and was verified."
    else
        echo "CRITICAL: Deployment failed and rollback verification failed."
    fi
    return 1
}

fail_and_rollback() {
    local failure="$1"
    echo "ERROR: $failure" >&2
    rollback || true
    exit 1
}

if ! container_running; then
    echo "ERROR: Current API container is not running; refusing deployment." >&2
    exit 1
fi

if [[ -n "${TASKFLOW_ROLLBACK_CONFIG_DIR:-}" ]] &&
    [[ ! -s "$TASKFLOW_ROLLBACK_CONFIG_DIR/compose.yaml" ||
        ! -s "$TASKFLOW_ROLLBACK_CONFIG_DIR/nginx.conf" ]]; then
    echo "ERROR: Rollback configuration backup is incomplete; refusing deployment." >&2
    exit 1
fi

OLD_IMAGE_ID="$(sudo docker inspect --format '{{.Image}}' "$CONTAINER" 2>/dev/null)" || {
    echo "ERROR: Could not capture the current API image identity." >&2
    exit 1
}
if [[ ! "$OLD_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "ERROR: Current API image identity is invalid; refusing deployment." >&2
    exit 1
fi

OLD_REPO_DIGESTS="$(
    sudo docker image inspect "$OLD_IMAGE_ID" \
        --format '{{range .RepoDigests}}{{println .}}{{end}}' 2>/dev/null
)" || {
    echo "ERROR: Could not inspect the current API image for a rollback reference." >&2
    exit 1
}
OLD_IMAGE_REF=""
while IFS= read -r repo_digest; do
    if [[ "$repo_digest" == "$IMAGE_REPO@sha256:"* ]]; then
        candidate_digest="${repo_digest#"$IMAGE_REPO"@sha256:}"
        if [[ "$candidate_digest" =~ ^[0-9a-f]{64}$ ]]; then
            OLD_IMAGE_REF="$repo_digest"
            break
        fi
    fi
done <<< "$OLD_REPO_DIGESTS"

if [[ -z "$OLD_IMAGE_REF" ]]; then
    echo "ERROR: No valid previous image digest for this repository; refusing deployment." >&2
    exit 1
fi

ROLLBACK_IMAGE_ID="$(
    sudo docker image inspect "$OLD_IMAGE_REF" --format '{{.Id}}' 2>/dev/null
)" || {
    echo "ERROR: Could not verify the previous image digest reference." >&2
    exit 1
}
if [[ "$ROLLBACK_IMAGE_ID" != "$OLD_IMAGE_ID" ]]; then
    echo "ERROR: Previous image digest does not match the running image; refusing deployment." >&2
    exit 1
fi

echo "========== TASKFLOW DEPLOYMENT =========="
echo "Requested immutable image: $NEW_IMAGE"
echo "Previous image identity captured for rollback."

if ! sudo docker pull "$NEW_IMAGE" >/dev/null 2>&1; then
    fail_and_rollback "Could not pull the requested image."
fi

NEW_IMAGE_ID="$(sudo docker image inspect "$NEW_IMAGE" --format '{{.Id}}' 2>/dev/null)" || {
    fail_and_rollback "Could not verify the pulled image identity."
}
if [[ ! "$NEW_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    fail_and_rollback "The pulled image identity is invalid."
fi

if ! compose_api_with_image "$NEW_IMAGE"; then
    fail_and_rollback "Compose could not update the API service."
fi

healthy=0
for ((attempt = 1; attempt <= HEALTH_ATTEMPTS; attempt++)); do
    if verify_deployed_image "$NEW_IMAGE_ID"; then
        healthy=1
        break
    fi
    sleep "$RETRY_SECONDS"
done

if [[ "$healthy" -ne 1 ]]; then
    fail_and_rollback "The new API image did not pass identity and readiness checks."
fi

echo "SUCCESS: TaskFlow deployment is healthy."
echo "Deployed image: $NEW_IMAGE"
