{
  "name": "cst-study-matrix-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .. --ignore-unknown --config ../.prettierrc.json --ignore-path ../.prettierignore",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .. --ignore-unknown --config ../.prettierrc.json --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.3.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "^10.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
