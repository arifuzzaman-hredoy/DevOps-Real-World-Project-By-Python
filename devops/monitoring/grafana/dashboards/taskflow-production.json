{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Plain-English health overview of the TaskFlow production system: website, server, traffic, speed and alerts.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this page",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Green** = healthy. **Yellow** = keep an eye on it. **Red** = needs action now.\n\nNumbers update automatically every 10 seconds and graphs cover the last hour. Hover over the **i** icon at the top-left of any panel to see what it shows and when to worry.\n\nThe page reads top to bottom: 1) is the website working, 2) is the server healthy, 3) how traffic and speed look over time, 4) how the server resources look over time, 5) any alerts."
      }
    },
    {
      "type": "row",
      "title": "1. Is the website working?",
      "collapsed": false,
      "id": 2,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Website Status",
      "description": "Shows whether monitoring can reach the TaskFlow app (its backend API). ONLINE means the app is answering. OFFLINE means it is down or unreachable: check the server first.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(up{job=\"cst-matrix-backend\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Traffic Right Now",
      "description": "How many requests per second visitors and apps are sending to the website. Every page load or button click that talks to the server counts. Low numbers are normal for a small site.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "mappings": [],
          "noValue": "No data",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(taskflow_http_requests_total[2m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Server Error Rate",
      "description": "Out of all requests, the percentage the server failed to handle (HTTP 5xx errors). 0% is perfect. Above 1% some users are seeing errors. Above 5% treat it as an incident.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "noValue": "No data",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (sum(rate(taskflow_http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(taskflow_http_requests_total[5m])), 0.001)",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Page Response Time",
      "description": "How long the server takes to answer a request. This is the 95th percentile: 95 out of 100 requests were answered faster than this number. Under 200 ms feels instant. Over 1 second feels slow.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "noValue": "No traffic",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taskflow_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Alerts Firing",
      "description": "The number of alert rules that are triggered right now. 0 is what you want. Section 5 at the bottom of this page lists which alerts are firing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "None",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Monitoring Coverage",
      "description": "Monitoring collects numbers from several places (the TaskFlow app and the server itself). 100% means every place is reporting. Less than 100% means some graphs on this page may be empty.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "noValue": "No data",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum(up) / count(up)",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "2. Is the server healthy?",
      "collapsed": false,
      "id": 9,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "CPU Usage",
      "description": "How busy the server’s processor (CPU) is right now. Think of it as how hard the server is working. Under 70% is healthy. Staying above 90% means the server is overloaded and the site may slow down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])))",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "Memory Usage (RAM)",
      "description": "How much of the server’s memory (RAM) is in use. RAM is the fast working space programs need while they run. Under 75% is healthy. Above 90% the server may become slow or stop programs to free space.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (1 - avg(node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "gauge",
      "title": "Disk Space Used",
      "description": "How full the server’s main hard drive is. If it reaches 100%, the database and the app can crash. Above 85%, delete old files, logs or unused Docker images.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype=~\"ext4|xfs|btrfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype=~\"ext4|xfs|btrfs\"}))",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "type": "gauge",
      "title": "Swap Used",
      "description": "Swap is slow emergency memory stored on the disk. It is only used when RAM is full. 0% is ideal. A high value for a long time means the server needs more RAM.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 25
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg(100 * (node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes) / clamp_min(node_memory_SwapTotal_bytes, 1))",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "type": "gauge",
      "title": "Server Load",
      "description": "Load shows how many tasks are waiting for the CPU compared with the number of CPU cores. 100% means every core is fully busy. Above 100% tasks are queueing and things slow down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 200,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * avg(node_load1) / count(count by (cpu) (node_cpu_seconds_total))",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Server Uptime",
      "description": "How long the server has been running since its last restart. If this number is small and you did not restart the server yourself, it rebooted unexpectedly.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "noValue": "No data",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(time() - node_boot_time_seconds)",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "3. Website traffic and speed over time",
      "collapsed": false,
      "id": 16,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Visitor Requests Over Time",
      "description": "Requests per second reaching the website, split by outcome. Green = the request worked. Yellow = the app said no (for example a wrong password or a missing page). Red = the server itself failed. The red line should stay flat at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisLabel": "",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Successful (2xx)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rejected by the app (4xx)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Server errors (5xx)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
